# L&D Studio — server configuration (copy to .env only if you want to override defaults;
# the server reads plain environment variables — this file documents them)
# The application is local-first by default. NOTHING here is a secret by design.

# Bind address. Local mode: 127.0.0.1. Hosted mode ignores this and binds 0.0.0.0.
LD_STUDIO_HOST=127.0.0.1

# Port for the local server.
LD_STUDIO_PORT=8385

# Ollama API base URL on this machine.
OLLAMA_URL=http://127.0.0.1:11434

# Preferred generation model (defaults to the first model Ollama reports).
LD_STUDIO_MODEL=

# Set to 1 to switch to hosted mode (binds 0.0.0.0 and requires HTTP-Basic auth).
LD_STUDIO_HOSTED=0

# Where local runtime data lives (voice models, hosted users file, temp audio).
LD_STUDIO_DATA_DIR=

# Override web assets directory (defaults to ld-studio/web).
LD_STUDIO_WEB_DIR=

# Piper binary + voices dir override (defaults: PATH + ~/.local/bin/piper, ./data/voices).
PIPER_BIN=
PIPER_VOICES_DIR=

# ffmpeg override (defaults to PATH lookup). Missing ffmpeg keeps WAV export working.
FFMPEG_BIN=

# Allow the server to auto-download a missing voice model from HuggingFace (63 MB each).
LD_STUDIO_ALLOW_VOICE_DOWNLOAD=1
