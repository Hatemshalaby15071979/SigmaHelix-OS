#!/usr/bin/env bash
# Run SigmaHelix straight from a source checkout.
#
# Prefer the repository virtualenv, fall back to whatever "sigmahelix" is on
# PATH, and fail with a clear message when neither exists.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python_bin="$repo_root/.venv/bin/python"

if [[ -x "$python_bin" ]]; then
  export PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}"
  exec "$python_bin" -m sigmahelix "$@"
fi

if command -v sigmahelix >/dev/null 2>&1; then
  exec sigmahelix "$@"
fi

cat >&2 <<'EOF'
SigmaHelix is not installed yet.

  from this checkout:  ./packaging/install.sh --dev
  for every user:      ./packaging/install.sh
EOF
exit 2
