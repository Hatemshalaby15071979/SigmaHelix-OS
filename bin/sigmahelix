#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
version="$(<"$repo_root/VERSION")"
if [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
  printf 'sigmahelix %s\n' "$version"
  exit 0
fi
if [[ "${1:-}" == "--cli" ]]; then
  shift
  python_bin="$repo_root/.venv/bin/python"
  if [[ ! -x "$python_bin" ]]; then
    echo "Create the local environment with: python3.12 -m venv .venv" >&2
    exit 2
  fi
  exec "$python_bin" "$repo_root/apps/desktop/console_os.py" "$@"
fi
python_bin="$repo_root/.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  echo "Create the local environment with: python3.12 -m venv .venv" >&2
  exit 2
fi
exec "$python_bin" "$repo_root/apps/desktop/main.py" "$@"
